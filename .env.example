# =========================================================
# PlateMates Environment Variables
# =========================================================
# This file is only an example template.
#
# After cloning the repository:
#
# BACKEND SETUP
# 1. Create a new .env file inside the backend folder.
# 2. Add:

# Backend server port.
PORT=5000
# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/platemates
# JWT secret used for authentication tokens.
# Change this to a long random string.
JWT_SECRET=change_this_to_a_random_string

# FRONTEND SETUP
# 3. Create a new .env file inside the frontend folder.
# 4. Add:

# Backend API URL used by the frontend.
VITE_API_URL=http://localhost:5000

# IMPORTANT:
# - Never commit real .env files to GitHub.
# - Keep secrets/private keys private.
# - Frontend env variables MUST start with VITE_.